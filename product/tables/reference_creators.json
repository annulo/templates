{
  "name": "参考博主",
  "desc": "每条记录一个平台账号；同一人物或品牌按 person_key 归组",
  "json_schema": {
    "type": "object",
    "properties": {
      "nickname": {
        "type": "string",
        "description": "平台昵称"
      },
      "platform": {
        "type": "string",
        "description": "xiaohongshu / douyin / x / other"
      },
      "profile_url": {
        "type": "string",
        "description": "原始主页链接"
      },
      "canonical_url": {
        "type": "string",
        "description": "规范主页链接"
      },
      "handle": {
        "type": "string",
        "description": "平台账号 ID"
      },
      "person_key": {
        "type": "string",
        "description": "确认属于同一人物或品牌的跨平台归组标识"
      },
      "creator_type": {
        "type": "string",
        "description": "官方品牌 / 创始人 / 设计 / AI / 增长 / 竞品 / 媒体 / 其他"
      },
      "avatar_url": {
        "type": "string",
        "description": "头像地址"
      },
      "bio": {
        "type": "string",
        "description": "主页简介"
      },
      "content_focus": {
        "type": "string",
        "description": "内容方向"
      },
      "tags": {
        "type": "string",
        "description": "标签 JSON 数组"
      },
      "status": {
        "type": "string",
        "description": "watching / active / paused / archived"
      },
      "priority": {
        "type": "string",
        "description": "low / normal / high"
      },
      "snapshot_at": {
        "type": "string",
        "description": "指标快照时间 ISO8601"
      },
      "notes": {
        "type": "string",
        "description": "观察备注"
      },
      "created_at": {
        "type": "string",
        "description": "创建时间"
      },
      "updated_at": {
        "type": "string",
        "description": "更新时间"
      },
      "legacy_key": {
        "type": "string",
        "description": "旧库与记录组合标识"
      },
      "legacy_snapshot": {
        "type": "string",
        "description": "旧库原始记录 JSON"
      },
      "followers_count": {
        "type": [
          "number",
          "null"
        ],
        "description": "带快照时间的指标，未知为 null"
      },
      "likes_count": {
        "type": [
          "number",
          "null"
        ],
        "description": "带快照时间的指标，未知为 null"
      },
      "user_id": {
        "type": "string",
        "description": "平台的用户 id（小红书主页地址里的那段），同步用"
      },
      "synced_at": {
        "type": "string",
        "description": "上次自动同步笔记的时间 ISO8601"
      },
      "sync_error": {
        "type": "string",
        "description": "上次同步失败的原因，成功清空"
      }
    },
    "required": [
      "nickname",
      "platform",
      "profile_url"
    ]
  }
}
