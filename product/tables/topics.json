{
  "name": "选题",
  "desc": "内容选题池，也是选题记忆，避免重复",
  "json_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "description": "选题标题"
      },
      "angle": {
        "type": "string",
        "description": "切入点 / 写作思路"
      },
      "keywords": {
        "type": "string",
        "description": "目标关键词，逗号分隔"
      },
      "source": {
        "type": "string",
        "description": "来源：manual / agent / search / geo / research"
      },
      "status": {
        "type": "string",
        "description": "idea / writing / done / dropped"
      },
      "article_id": {
        "type": "string",
        "description": "写成的文章"
      },
      "search_query": {
        "type": "string",
        "description": "来自搜索（source=search）：对应的 Google 搜索词"
      },
      "search_impressions": {
        "type": "number",
        "description": "来自搜索：这个词近 28 天的曝光（gsc.sync 更新）"
      },
      "search_position": {
        "type": "number",
        "description": "来自搜索：这个词近 28 天的平均排名"
      },
      "created_at": {
        "type": "string",
        "description": "创建时间 ISO8601"
      },
      "brief": {
        "type": "string",
        "description": "编辑选题 JSON：audience / buyer_question / product_ids / outline / language / channels / cta / gaps"
      },
      "campaign_id": {
        "type": "string",
        "description": "关联运营主题 id"
      },
      "opportunity_id": {
        "type": "string",
        "description": "关联增长机会 id"
      },
      "product_id": {
        "type": "string",
        "description": "关联产品事实 id"
      },
      "target_platform": {
        "type": "string",
        "description": "目标平台 website / xiaohongshu / douyin / x"
      },
      "content_type": {
        "type": "string",
        "description": "article / post / video"
      },
      "target_account_id": {
        "type": "string",
        "description": "目标社媒账号 ID，账号名不能代替身份"
      },
      "account_role_key": {
        "type": "string",
        "description": "账号内容策略标识"
      },
      "plan_key": {
        "type": "string",
        "description": "同一主题内稳定内容版本标识"
      },
      "marketing_plan_id": {
        "type": "string",
        "description": "原营销计划记录 ID"
      }
    },
    "required": [
      "title"
    ]
  }
}
