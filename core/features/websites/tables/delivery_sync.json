{
  "name": "客户后台报告同步",
  "desc": "按站点和报告类型保留最新待同步快照；凭据不进入报告。deliverysync.sync 重试失败，正常采集完成后自动同步。",
  "json_schema": {
    "type": "object",
    "properties": {
      "key": {
        "type": "string"
      },
      "channel_id": {
        "type": "string"
      },
      "report_id": {
        "type": "string"
      },
      "payload": {
        "type": "string"
      },
      "status": {
        "type": "string"
      },
      "collected_at": {
        "type": "string"
      },
      "attempted_at": {
        "type": "string"
      },
      "synced_at": {
        "type": "string"
      },
      "error": {
        "type": "string"
      },
      "attempts": {
        "type": "integer"
      },
      "remote_id": {
        "type": "string"
      },
      "target_project": {
        "type": "string"
      },
      "target_site": {
        "type": "string"
      },
      "target_host": {
        "type": "string"
      }
    },
    "required": [
      "key",
      "channel_id",
      "payload"
    ]
  }
}
