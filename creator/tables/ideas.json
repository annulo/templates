{
  "name": "选题",
  "desc": "想写的题目：AI 出的或自己记的。写成稿件后 status 变成 drafting，稿件的 idea_id 指回这里",
  "json_schema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "description": "题目" },
      "angle": { "type": "string", "description": "切入角度：为什么值得写、写什么不一样的" },
      "notes": { "type": "string", "description": "素材、想法、链接" },
      "status": { "type": "string", "description": "idea 待写 / drafting 写成了稿件 / dropped 不写了" },
      "source": { "type": "string", "description": "ai：AI 出的；manual：自己记的" },
      "created_at": { "type": "string" },
      "updated_at": { "type": "string" }
    },
    "required": ["title"]
  }
}
